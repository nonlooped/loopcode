{
  "name": "loopcode",
  "private": true,
  "version": "1.0.0",
  "description": "LoopCode — local AI coding agent",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "tsc --noEmit && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "test": "tsc --noEmit && vitest run && cargo test --manifest-path src-tauri/Cargo.toml && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-capabilities.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-license.ps1 && npm run sbom:check",
    "test:unit": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:web": "vitest run",
    "test:web:watch": "vitest",
    "sbom": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-sbom.ps1",
    "sbom:check": "npm run sbom && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-sbom-licenses.ps1",
    "checksums": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-checksums.ps1",
    "release-gate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-gate.ps1",
    "release:spot": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-spot-regression.ps1",
    "license:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-license.ps1",
    "catalog:refresh": "node scripts/refresh-models-catalog.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@lobehub/icons-static-svg": "^1.91.0",
    "@streamdown/code": "^1.1.1",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-query": "^5.101.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "diff": "^9.0.0",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "streamdown": "^2.5.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cyclonedx/cdxgen": "^11.9.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2",
    "@types/diff": "^7.0.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~5.6.2",
    "vite": "^8.1.4",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
