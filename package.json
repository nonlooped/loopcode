{
  "name": "loopcode",
  "version": "0.9.0",
  "private": true,
  "description": "A local desktop workspace for ACP coding agents.",
  "keywords": [
    "acp",
    "agent-client-protocol",
    "ai-coding",
    "claude",
    "codex",
    "coding-agents",
    "cursor",
    "fx",
    "grok",
    "opencode",
    "pi",
    "svelte",
    "tauri"
  ],
  "homepage": "https://github.com/nonlooped/loopcode",
  "bugs": "https://github.com/nonlooped/loopcode/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nonlooped/loopcode.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "web": "vp dev --host 127.0.0.1",
    "build": "vp build",
    "check": "svelte-check --tsconfig ./tsconfig.json && vp check",
    "check:versions": "node scripts/check-versions.mjs",
    "test": "node --test tests/*.test.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@humanspeak/svelte-markdown": "^1.8.7",
    "@lobehub/icons-static-svg": "^1.94.0",
    "@tabler/icons-svelte": "^3.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bits-ui": "^2.19.0",
    "material-icon-theme": "^5.37.0",
    "shiki": "^4.4.3",
    "svelte": "^5.56.10",
    "tailwindcss": "^4.3.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.2.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite-plus": "^0.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=12",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=24"
    }
  }
}
